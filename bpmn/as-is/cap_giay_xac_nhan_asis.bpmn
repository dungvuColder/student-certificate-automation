<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Defs_AsIs" targetNamespace="http://uet.vnu.edu.vn/btl-khdv/nhom16"
  exporter="BTL KHDV Nhom 16" exporterVersion="1.0">
<bpmn:collaboration id="Collab_AsIs">
<bpmn:participant id="Pool_SinhVien" name="Sinh viên" processRef="Process_SinhVien" />
<bpmn:participant id="Pool_UET" name="Trường ĐH Công nghệ (UET)" processRef="Process_CapGiayXacNhan_AsIs" />
<bpmn:messageFlow id="M1" name="Yêu cầu giấy xác nhận" sourceRef="SV_GuiYeuCau" targetRef="HUB_Start" />
<bpmn:messageFlow id="M2" name="Trạng thái &quot;Từ chối&quot;" sourceRef="CTSV_EndTuChoi" targetRef="SV_NhanTuChoi" />
<bpmn:messageFlow id="M3" name="Trạng thái &quot;Đã xong&quot;" sourceRef="HUB_ThongBao" targetRef="SV_NhanDaXong" />
<bpmn:messageFlow id="M4" name="Sinh viên có mặt" sourceRef="SV_DenNhan" targetRef="CTSV_SVDen" />
</bpmn:collaboration>
<bpmn:process id="Process_SinhVien" isExecutable="false">
<bpmn:startEvent id="SV_Start" name="Cần giấy xác nhận sinh viên"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="SV_GuiYeuCau" name="Gửi yêu cầu trên StudentHub"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:sendTask>
<bpmn:eventBasedGateway id="SV_Cho" name=""><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="SV_NhanTuChoi" name="Nhận thông báo từ chối"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing><bpmn:messageEventDefinition id="SV_NhanTuChoi_md" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="SV_EndTuChoi" name="Không nhận được giấy"><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="SV_NhanDaXong" name="Thấy trạng thái &quot;Đã xong&quot;"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:messageEventDefinition id="SV_NhanDaXong_md" /></bpmn:intermediateCatchEvent>
<bpmn:sendTask id="SV_DenNhan" name="Đến phòng CTSV nhận giấy (giờ hành chính)"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="SV_End" name="Đã có giấy xác nhận"><bpmn:incoming>F7</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" name="" sourceRef="SV_Start" targetRef="SV_GuiYeuCau" />
<bpmn:sequenceFlow id="F2" name="" sourceRef="SV_GuiYeuCau" targetRef="SV_Cho" />
<bpmn:sequenceFlow id="F3" name="" sourceRef="SV_Cho" targetRef="SV_NhanTuChoi" />
<bpmn:sequenceFlow id="F4" name="" sourceRef="SV_Cho" targetRef="SV_NhanDaXong" />
<bpmn:sequenceFlow id="F5" name="" sourceRef="SV_NhanTuChoi" targetRef="SV_EndTuChoi" />
<bpmn:sequenceFlow id="F6" name="" sourceRef="SV_NhanDaXong" targetRef="SV_DenNhan" />
<bpmn:sequenceFlow id="F7" name="" sourceRef="SV_DenNhan" targetRef="SV_End" />
</bpmn:process>
<bpmn:process id="Process_CapGiayXacNhan_AsIs" isExecutable="false">
<bpmn:laneSet id="LaneSet_UET">
<bpmn:lane id="Lane_StudentHub" name="StudentHub"><bpmn:flowNodeRef>HUB_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>HUB_Luu</bpmn:flowNodeRef><bpmn:flowNodeRef>HUB_ThongBao</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_CTSV" name="Chuyên viên phòng CTSV"><bpmn:flowNodeRef>CTSV_DotXuLy</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_MoDS</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_TraCuu</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_HopLe</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_TuChoi</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_EndTuChoi</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_Soan</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_DotTrinh</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_Trinh</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_DaXong</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_SVDen</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_TraGiay</bpmn:flowNodeRef><bpmn:flowNodeRef>CTSV_End</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_LanhDao" name="Lãnh đạo phòng CTSV"><bpmn:flowNodeRef>LD_Ky</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_VanThu" name="Văn thư"><bpmn:flowNodeRef>VT_DongDau</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="HUB_Start" name="Nhận yêu cầu"><bpmn:outgoing>U1</bpmn:outgoing><bpmn:messageEventDefinition id="HUB_Start_md" /></bpmn:startEvent>
<bpmn:serviceTask id="HUB_Luu" name="Lưu yêu cầu, đặt trạng thái &quot;Đang làm&quot;"><bpmn:incoming>U1</bpmn:incoming><bpmn:outgoing>U2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:intermediateThrowEvent id="HUB_ThongBao" name="Hiển thị &quot;Đã xong&quot;"><bpmn:incoming>U14</bpmn:incoming><bpmn:outgoing>U15</bpmn:outgoing><bpmn:messageEventDefinition id="HUB_ThongBao_md" /></bpmn:intermediateThrowEvent>
<bpmn:intermediateCatchEvent id="CTSV_DotXuLy" name="Đến đợt xử lý (sáng/chiều)"><bpmn:incoming>U2</bpmn:incoming><bpmn:outgoing>U3</bpmn:outgoing><bpmn:timerEventDefinition id="CTSV_DotXuLy_td"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:userTask id="CTSV_MoDS" name="Mở danh sách yêu cầu mới"><bpmn:incoming>U3</bpmn:incoming><bpmn:outgoing>U4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="CTSV_TraCuu" name="Tra cứu tình trạng học tập trên HT đào tạo"><bpmn:incoming>U4</bpmn:incoming><bpmn:outgoing>U5</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="CTSV_HopLe" name="Hợp lệ?"><bpmn:incoming>U5</bpmn:incoming><bpmn:outgoing>U6</bpmn:outgoing><bpmn:outgoing>U7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="CTSV_TuChoi" name="Cập nhật &quot;Từ chối&quot; trên StudentHub"><bpmn:incoming>U7</bpmn:incoming><bpmn:outgoing>U8</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="CTSV_EndTuChoi" name="Đã từ chối"><bpmn:incoming>U8</bpmn:incoming><bpmn:messageEventDefinition id="CTSV_EndTuChoi_md" /></bpmn:endEvent>
<bpmn:manualTask id="CTSV_Soan" name="Soạn giấy từ mẫu Word, in"><bpmn:incoming>U6</bpmn:incoming><bpmn:outgoing>U9</bpmn:outgoing></bpmn:manualTask>
<bpmn:intermediateCatchEvent id="CTSV_DotTrinh" name="Đến đợt trình ký"><bpmn:incoming>U9</bpmn:incoming><bpmn:outgoing>U10</bpmn:outgoing><bpmn:timerEventDefinition id="CTSV_DotTrinh_td"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT12H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:manualTask id="CTSV_Trinh" name="Trình ký theo lô"><bpmn:incoming>U10</bpmn:incoming><bpmn:outgoing>U11</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="LD_Ky" name="Ký duyệt (chờ 2–24 giờ)"><bpmn:incoming>U11</bpmn:incoming><bpmn:outgoing>U12</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="VT_DongDau" name="Đóng dấu, vào sổ văn bản"><bpmn:incoming>U12</bpmn:incoming><bpmn:outgoing>U13</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="CTSV_DaXong" name="Cập nhật &quot;Đã xong&quot; trên StudentHub"><bpmn:incoming>U13</bpmn:incoming><bpmn:outgoing>U14</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="CTSV_SVDen" name="Sinh viên đến nhận"><bpmn:incoming>U15</bpmn:incoming><bpmn:outgoing>U16</bpmn:outgoing><bpmn:messageEventDefinition id="CTSV_SVDen_md" /></bpmn:intermediateCatchEvent>
<bpmn:manualTask id="CTSV_TraGiay" name="Kiểm tra thẻ SV, trả giấy, SV ký nhận"><bpmn:incoming>U16</bpmn:incoming><bpmn:outgoing>U17</bpmn:outgoing></bpmn:manualTask>
<bpmn:endEvent id="CTSV_End" name="Hoàn tất"><bpmn:incoming>U17</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="U1" name="" sourceRef="HUB_Start" targetRef="HUB_Luu" />
<bpmn:sequenceFlow id="U2" name="" sourceRef="HUB_Luu" targetRef="CTSV_DotXuLy" />
<bpmn:sequenceFlow id="U3" name="" sourceRef="CTSV_DotXuLy" targetRef="CTSV_MoDS" />
<bpmn:sequenceFlow id="U4" name="" sourceRef="CTSV_MoDS" targetRef="CTSV_TraCuu" />
<bpmn:sequenceFlow id="U5" name="" sourceRef="CTSV_TraCuu" targetRef="CTSV_HopLe" />
<bpmn:sequenceFlow id="U6" name="Có" sourceRef="CTSV_HopLe" targetRef="CTSV_Soan" />
<bpmn:sequenceFlow id="U7" name="Không (thôi học, bảo lưu, sai thông tin)" sourceRef="CTSV_HopLe" targetRef="CTSV_TuChoi" />
<bpmn:sequenceFlow id="U8" name="" sourceRef="CTSV_TuChoi" targetRef="CTSV_EndTuChoi" />
<bpmn:sequenceFlow id="U9" name="" sourceRef="CTSV_Soan" targetRef="CTSV_DotTrinh" />
<bpmn:sequenceFlow id="U10" name="" sourceRef="CTSV_DotTrinh" targetRef="CTSV_Trinh" />
<bpmn:sequenceFlow id="U11" name="" sourceRef="CTSV_Trinh" targetRef="LD_Ky" />
<bpmn:sequenceFlow id="U12" name="" sourceRef="LD_Ky" targetRef="VT_DongDau" />
<bpmn:sequenceFlow id="U13" name="" sourceRef="VT_DongDau" targetRef="CTSV_DaXong" />
<bpmn:sequenceFlow id="U14" name="" sourceRef="CTSV_DaXong" targetRef="HUB_ThongBao" />
<bpmn:sequenceFlow id="U15" name="" sourceRef="HUB_ThongBao" targetRef="CTSV_SVDen" />
<bpmn:sequenceFlow id="U16" name="" sourceRef="CTSV_SVDen" targetRef="CTSV_TraGiay" />
<bpmn:sequenceFlow id="U17" name="" sourceRef="CTSV_TraGiay" targetRef="CTSV_End" />
<bpmn:textAnnotation id="A1"><bpmn:text>Chờ 0–4 giờ: yêu cầu nằm chờ đến đợt xử lý</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A1_as" sourceRef="CTSV_DotXuLy" targetRef="A1" />
<bpmn:textAnnotation id="A2"><bpmn:text>Nhập lại MSSV thủ công (2 hệ thống không liên thông)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A2_as" sourceRef="CTSV_TraCuu" targetRef="A2" />
<bpmn:textAnnotation id="A3"><bpmn:text>Trình ký theo lô: chờ đến đợt</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A3_as" sourceRef="CTSV_Trinh" targetRef="A3" />
</bpmn:process>
